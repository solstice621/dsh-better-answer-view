{
  "name": "dsh-web-answer",
  "version": "0.3.1",
  "description": "DSH Better AnswerView: inline charts, cards, and interactive answers for DeepSeek Harness, with durable state and revisions.",
  "type": "module",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "main": "src/host.js",
  "exports": {
    ".": "./src/host.js",
    "./client": "./dist/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-tool",
        "@deepseek-ai/dsh-client-ui-chat",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-api-session-controller"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": "0.1.5-rc.3 || 0.2.1-rc.3"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-tools": {
      "optional": true
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test test/*.test.js",
    "test:browser": "node test/browser.mjs",
    "demo": "node scripts/demo-server.mjs"
  },
  "devDependencies": {
    "esbuild": "0.25.12",
    "playwright": "1.56.1",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "files": [
    "src",
    "dist",
    "examples",
    "scripts",
    "cordis.patch.yml",
    "README.md",
    "VALIDATION.md",
    "LICENSE"
  ]
}
